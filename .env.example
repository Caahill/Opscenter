# Core
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://opshub:opshub@localhost:5432/opshub
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=opshub-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
STORAGE_DRIVER=s3           # s3 (MinIO, AWS) | fs (local disk, for machines without Docker)

# Encryption (local only: static dev keys; staging and prod use KMS)
KMS_MODE=local
LOCAL_PII_KEY=
LOCAL_VAULT_KEY=
HASH_PEPPER=
# KMS_MODE=aws only:
KMS_PII_KEY_ID=
KMS_VAULT_KEY_ID=
AWS_REGION=ap-south-1

# Auth
AUTH_MODE=dev                # dev = pick a seed user at login; google = real OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=syspreedigital.com,syspreesolutions.com

# Integrations (fakes locally and in tests; live only on staging and production)
GMAIL_MODE=fake              # fake | live (live uses GOOGLE_CLIENT_ID/SECRET for mailbox consent)
GMAIL_PUBSUB_TOPIC=          # projects/<project>/topics/<topic>
GMAIL_PUBSUB_AUDIENCE=       # push token audience; defaults to <API_URL>/api/v1/webhooks/gmail
GMAIL_PUBSUB_SERVICE_ACCOUNT=  # the push subscription's service account email
GMAIL_BACKFILL_YEARS=3
WHATSAPP_MODE=fake           # fake | live
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATES=          # approved templates for replies after 24 hours, e.g. hello_world:en_US
AI_MODE=fake                 # fake | live
ANTHROPIC_API_KEY=
AI_TRIAGE_MODEL=claude-haiku-5-5
AI_FALLBACK_MODEL=claude-sonnet-5-5
CLICKUP_TOKEN=

# Notifications (PRD 5.3)
MAIL_MODE=file               # file = .eml files in .local-mail/ (no Docker) | smtp = Mailpit locally, the relay in production
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Ops Hub <opshub@syspree.example>
PUSH_VAPID_PUBLIC_KEY=       # pnpm keys:generate --write fills both
PUSH_VAPID_PRIVATE_KEY=
PUSH_SUBJECT=mailto:ops@syspree.example
REALTIME_URL=                # optional: where the browser opens its live connection; defaults to API_URL locally, this origin in production

{
  "name": "@opshub/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput --path tsconfig.dev.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:masking": "vitest run -c vitest.masking.config.mts",
    "seed:demo": "tsx src/seed/run-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1156.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/websockets": "11.2.8",
    "@opshub/db": "workspace:*",
    "@opshub/integrations": "workspace:*",
    "@opshub/policy": "workspace:*",
    "@opshub/shared": "workspace:*",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "google-auth-library": "10.9.1",
    "ioredis": "5.11.1",
    "pino": "9.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.20",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/supertest": "6.0.3",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
